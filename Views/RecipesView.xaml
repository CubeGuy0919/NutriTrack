<UserControl x:Class="NutriTrack.UI.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:NutriTrack.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:CategoryIconConverter x:Key="CategoryIconConverter" />
        <conv:CategoryBrushConverter x:Key="CategoryBrushConverter" />
        <conv:DifficultyBrushConverter x:Key="DifficultyBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <!-- Round translucent button used for the image slideshow arrows -->
        <Style x:Key="SlideNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" CornerRadius="15" Background="#66000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One recipe card -->
        <DataTemplate x:Key="RecipeCardTemplate">
            <Button Click="RecipeCard_Click" Tag="{Binding}" Cursor="Hand"
                    Width="266" Margin="0,0,16,16" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" CornerRadius="14" Background="White"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Colored category strip -->
                                <Border CornerRadius="14,14,0,0" Height="64"
                                        Background="{Binding Category, Converter={StaticResource CategoryBrushConverter}}">
                                    <Grid>
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryIconConverter}}"
                                                   FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="#33000000" CornerRadius="8" Padding="7,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                            <TextBlock Text="{Binding Cuisine}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="16,14,16,16">
                                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold"
                                               Foreground="#1B2A20" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="42" Margin="0,0,0,10" />

                                    <!-- Meta row: time | calories | difficulty -->
                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⏱" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🔥" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CaloriesLabel}" FontSize="11" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🥣" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding IngredientCountLabel}" FontSize="11" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,2,0,0" TextAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border CornerRadius="10" Padding="0,5"
                                            Background="{Binding Difficulty, Converter={StaticResource DifficultyBrushConverter}}">
                                        <TextBlock Text="{Binding Difficulty}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (centered) -->
        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="📖 Recipes" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Search and browse by cuisine, category or time — click a card for the full recipe."
                       Foreground="#6B7A70" FontSize="13.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Search + dropdown filters -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14" VerticalAlignment="Center">
            <!-- Search Box container -->
            <Grid Width="240" Margin="0,0,10,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                 TextChanged="Filter_Changed" />
                <TextBlock Text="🔍 Search by name or ingredient…" Foreground="#9AA8A0" FontSize="14"
                   Margin="16,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox x:Name="CuisineCombo" Style="{StaticResource FilterComboStyle}"
              Margin="0,0,10,8" SelectionChanged="Filter_Changed" />

            <ComboBox x:Name="TimeCombo" Style="{StaticResource FilterComboStyle}"
              Margin="0,0,10,8" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any time" Tag="0" IsSelected="True" />
                <ComboBoxItem Content="Under 30 min" Tag="30" />
                <ComboBoxItem Content="30–60 min" Tag="60" />
                <ComboBoxItem Content="60–90 min" Tag="90" />
                <ComboBoxItem Content="Over 90 min" Tag="9999" />
            </ComboBox>

            <ComboBox x:Name="SortCombo" Style="{StaticResource FilterComboStyle}" SelectedIndex="0"
              Margin="0,0,10,8" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Sort: Name A–Z" />
                <ComboBoxItem Content="Sort: Quickest first" />
                <ComboBoxItem Content="Sort: Lowest calories" />
                <ComboBoxItem Content="Sort: Highest calories" />
            </ComboBox>

            <Button Content="Reset" Click="ClearFilters_Click"
            Margin="0,0,10,8" Padding="14,8" Background="Transparent" BorderThickness="1"
            Foreground="#2E7D32" FontWeight="SemiBold" BorderBrush="#A5D6A7" Cursor="Hand" />

            <Button Content="+ Add Recipe" Click="AddRecipe_Click"
            Margin="0,0,0,8" Padding="16,8" Background="{StaticResource PrimaryBrush}" BorderThickness="0"
            Foreground="White" FontWeight="SemiBold" Cursor="Hand" />
        </WrapPanel>

        <!-- Category chips + result count -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Using WrapPanel instead of StackPanel for responsive tag chips -->
            <WrapPanel x:Name="CategoryChips" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" />

            <TextBlock x:Name="ResultCountText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
               Foreground="#6B7A70" FontSize="12.5" Margin="10,0,0,0" />
        </Grid>

        <!-- Card grid -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="RecipeItemsControl" ItemTemplate="{StaticResource RecipeCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="🥲" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="No recipes match those filters." FontSize="15" Foreground="#6B7A70"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Detail panel (slides in when a card is selected) -->
        <Border x:Name="DetailBorder" Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                Visibility="Collapsed"
                Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0"
                Margin="20,0,0,20" Padding="22,20">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel">

                    <!-- Title + close -->
                    <Grid>
                        <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="24,0,24,4" />
                        <Button Content="✕" Click="CloseDetail_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Foreground="#9AA8A0" Cursor="Hand" FontSize="14" />
                    </Grid>
                    <TextBlock x:Name="DetailMeta" FontSize="12.5" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <!-- Recipe image / slideshow -->
                    <Border x:Name="DetailImageBorder" CornerRadius="10" ClipToBounds="True" Height="200"
                            Background="#EEF2EF" Margin="0,0,0,14">
                        <Grid>
                            <Image x:Name="DetailImage" Stretch="UniformToFill" />

                            <TextBlock x:Name="NoImageText" Text="No image available" Visibility="Collapsed"
                                       Foreground="White" Background="#99000000" Padding="10,4" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />

                            <Button x:Name="SlidePrevButton" Content="‹" Style="{StaticResource SlideNavButtonStyle}"
                                    HorizontalAlignment="Left" Visibility="Collapsed" Click="PrevSlide_Click" />
                            <Button x:Name="SlideNextButton" Content="›" Style="{StaticResource SlideNavButtonStyle}"
                                    HorizontalAlignment="Right" Visibility="Collapsed" Click="NextSlide_Click" />

                            <Border x:Name="SlideCounterBorder" Background="#88000000" CornerRadius="8" Padding="8,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="SlideCounterText" Foreground="White" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Prep / cook / calories per serving -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PREP" FontSize="10.5" FontWeight="Bold" Foreground="#9AA8A0" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DetailPrep" FontSize="15" FontWeight="SemiBold" Foreground="#1B2A20" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="COOK" FontSize="10.5" FontWeight="Bold" Foreground="#9AA8A0" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DetailCook" FontSize="15" FontWeight="SemiBold" Foreground="#1B2A20" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CALORIES / SERVING" FontSize="10.5" FontWeight="Bold" Foreground="#9AA8A0" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DetailCalories" FontSize="15" FontWeight="SemiBold" Foreground="#1B2A20" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock x:Name="DetailDescription" FontSize="13" TextWrapping="Wrap" Foreground="#3C4A42"
                               Margin="0,0,0,16" Visibility="Collapsed" />

                    <!-- SERVINGS -->
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="SERVINGS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1" FontSize="12" Foreground="#6B7A70" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider x:Name="ServingsSlider" Grid.Column="1"
                                        Minimum="1" Maximum="12" Value="4" SmallChange="1" LargeChange="1"
                                        TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="ServingsSlider_ValueChanged" />
                                <TextBlock x:Name="ServingsMaxText" Grid.Column="2" Text="12" FontSize="12" Foreground="#6B7A70"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="SelectedServingsText" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,8,0,0" />
                            <TextBlock x:Name="BaseServingsNote" FontSize="11.5" Foreground="#6B7A70" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <!-- Units: display only (scale first, then convert, then format) -->
                            <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="UNITS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton x:Name="UnitAsWrittenRadio" Content="As written" GroupName="UnitSystem" Tag="AsWritten"
                                             Click="UnitSystem_Click" FontSize="12" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                                <RadioButton x:Name="UnitMetricRadio" Content="Metric" GroupName="UnitSystem" Tag="Metric"
                                             Click="UnitSystem_Click" FontSize="12" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                                <RadioButton x:Name="UnitImperialRadio" Content="Imperial" GroupName="UnitSystem" Tag="Imperial"
                                             Click="UnitSystem_Click" FontSize="12" VerticalContentAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- INGREDIENTS (scaled, with pantry status) -->
                    <TextBlock Text="INGREDIENTS" FontSize="11" FontWeight="Bold" Foreground="#9AA8A0" Margin="0,0,0,8" />
                    <ItemsControl x:Name="DetailIngredients" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StatusSymbol}" FontSize="14" FontWeight="Bold" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9AA8A0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Available">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                        <Setter Property="Foreground" Value="#E08A00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="UnitMismatch">
                                                        <Setter Property="Foreground" Value="#E08A00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Missing">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Ingredient.DisplayText}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailLine}" FontSize="11.5" Foreground="#6B7A70" TextWrapping="Wrap" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="AddMissingButton" Content="Add missing ingredients to shopping list"
                            Click="AddMissing_Click" Padding="14,9" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" />
                    <TextBlock x:Name="ShoppingMessage" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- NUTRITION: per-serving values never change with the slider, totals do -->
                    <TextBlock Text="NUTRITION" FontSize="11" FontWeight="Bold" Foreground="#9AA8A0" Margin="0,20,0,8" />
                    <Grid x:Name="NutritionHeader" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="PER SERVING" FontSize="10.5" FontWeight="Bold" Foreground="#9AA8A0" HorizontalAlignment="Right" />
                        <TextBlock x:Name="NutritionTotalHeader" Grid.Column="2" FontSize="10.5" FontWeight="Bold" Foreground="#9AA8A0" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="NutritionRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding PerServingText}" FontSize="13" Foreground="#3C4A42" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NutritionNote" FontSize="11.5" FontStyle="Italic" Foreground="#6B7A70" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="Collapsed" />

                    <TextBlock Text="SENSITIVITIES" FontSize="11" FontWeight="Bold" Foreground="#9AA8A0" Margin="0,20,0,6" />
                    <TextBlock x:Name="DetailSensitivities" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <TextBlock Text="INSTRUCTIONS" FontSize="11" FontWeight="Bold" Foreground="#9AA8A0" Margin="0,0,0,6" />
                    <ItemsControl x:Name="DetailInstructions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="19" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
