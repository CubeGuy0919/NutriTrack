<UserControl x:Class="NutriTrack.UI.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Card / Panel Background Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#E3E8E4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Custom DataGrid Column Header Style -->
        <Style x:Key="FancyHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5F3" />
            <Setter Property="Foreground" Value="#2C3E35" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!-- Centered DataGrid Cell Text Style -->
        <Style x:Key="CenteredCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,8" />
        </Style>

        <!-- Left-Aligned Cell Style for Multi-line Texts -->
        <Style x:Key="LeftCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,8" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Section -->
            <RowDefinition Height="Auto" />
            <!-- Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Main Content DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 1. HERO HEADER (Center-Oriented) ===== -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="📖 Recipe Catalog" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2E7D32" 
                       HorizontalAlignment="Center" />
            <TextBlock Text="Browse step-by-step instructions, exact ingredients, and allergen sensitivities." 
                       FontSize="14" 
                       Foreground="#6B7A70" 
                       HorizontalAlignment="Center" 
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ===== 2. SEARCH & FILTER CONTROLS ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search Recipes or Ingredients" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                    <TextBox x:Name="SearchTextBox" 
                             Height="34" 
                             Padding="8,6" 
                             VerticalContentAlignment="Center"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"
                             TextChanged="FilterInput_Changed" />
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Category" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                    <ComboBox x:Name="CategoryComboBox" 
                              Height="34" 
                              VerticalContentAlignment="Center" 
                              SelectionChanged="FilterInput_Changed" />
                </StackPanel>

                <!-- Cuisine Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Cuisine" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                    <ComboBox x:Name="CuisineComboBox" 
                              Height="34" 
                              VerticalContentAlignment="Center" 
                              SelectionChanged="FilterInput_Changed" />
                </StackPanel>

                <!-- Reset Button -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="Reset Filters" 
                            Height="34" 
                            Padding="12,0" 
                            Background="#E8F5E9" 
                            Foreground="#2E7D32" 
                            FontWeight="SemiBold" 
                            BorderBrush="#A5D6A7"
                            Click="ResetFilters_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 3. DATAGRID & RESULTS COUNTER ===== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Results Counter -->
            <TextBlock x:Name="ResultCountText" 
                       Grid.Row="0" 
                       Text="Showing 0 recipes" 
                       Foreground="#6B7A70" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       Margin="4,0,0,8" />

            <!-- Responsive Styled DataGrid -->
            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" BorderBrush="#E3E8E4" BorderThickness="1">
                <DataGrid x:Name="RecipeDataGrid" MouseDoubleClick="RecipeDataGrid_MouseDoubleClick"
                        CanUserAddRows="False"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="False"
                        CanUserReorderColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="#F0F0F0"
                        Background="White"
                        RowHeight="42"
                        ColumnHeaderStyle="{StaticResource FancyHeaderStyle}"
                        AlternatingRowBackground="#FBFDFB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" 
                                            Binding="{Binding Name}" 
                                            Width="1.2*" 
                                            MinWidth="130"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Cuisine" 
                                            Binding="{Binding Cuisine}" 
                                            Width="0.8*" 
                                            MinWidth="90"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Category" 
                                            Binding="{Binding Category}" 
                                            Width="0.8*" 
                                            MinWidth="90"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Prep (min)" 
                                            Binding="{Binding PrepTimeMinutes}" 
                                            Width="Auto" 
                                            MinWidth="75"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Cook (min)" 
                                            Binding="{Binding CookTimeMinutes}" 
                                            Width="Auto" 
                                            MinWidth="75"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Calories" 
                                            Binding="{Binding CaloriesPerServing, StringFormat={}{0:F0} kcal}" 
                                            Width="Auto" 
                                            MinWidth="80"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Sensitivities" 
                                            Binding="{Binding FormattedSensitivities}" 
                                            Width="*" 
                                            MinWidth="100"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />

                        <DataGridTextColumn Header="Ingredients" 
                                            Binding="{Binding FormattedIngredients}" 
                                            Width="2.2*" 
                                            MinWidth="180"
                                            ElementStyle="{StaticResource LeftCellTextStyle}" />

                        <DataGridTextColumn Header="Instructions" 
                                            Binding="{Binding FormattedInstructions}" 
                                            Width="3.5*" 
                                            MinWidth="240"
                                            ElementStyle="{StaticResource LeftCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>