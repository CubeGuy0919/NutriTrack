<Window x:Class="NutriTrack.UI.Views.AddRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Recipe"
        Width="780" Height="840" MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7A70" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9AA8A0" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#A5D6A7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- One row in the ingredient list -->
        <DataTemplate x:Key="IngredientRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextWrapping="Wrap" />
                    <TextBlock Text="⚠ Not in the product list - pick a product from the dropdown"
                               FontSize="11" Foreground="#C62828">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProduct}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding QuantityLabel}" FontSize="13.5" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Edit" Tag="{Binding}" Click="EditIngredient_Click"
                            Style="{StaticResource OutlineButton}" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="Remove" Tag="{Binding}" Click="RemoveIngredient_Click"
                            Style="{StaticResource OutlineButton}" Padding="10,4"
                            Foreground="#C62828" BorderBrush="#EF9A9A" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="➕ Add New Recipe" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- ============ Recipe information ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="RECIPE INFORMATION" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Recipe name *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource SearchBoxStyle}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category *" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CategoryCombo" IsEditable="True" Padding="8,7" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cuisine *" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CuisineCombo" IsEditable="True" Padding="8,7" FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource SearchBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="110"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Preparation time (min)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PrepBox" Style="{StaticResource SearchBoxStyle}" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cooking time (min)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CookBox" Style="{StaticResource SearchBoxStyle}" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Base servings *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ServingsBox" Style="{StaticResource SearchBoxStyle}" Text="4" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Calories / serving *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CaloriesBox" Style="{StaticResource SearchBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Protein g (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProteinBox" Style="{StaticResource SearchBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Carbs g (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CarbsBox" Style="{StaticResource SearchBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Fat g (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FatBox" Style="{StaticResource SearchBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Food sensitivities (separate with commas, e.g. Gluten-Free, Vegan)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SensitivitiesBox" Style="{StaticResource SearchBoxStyle}" />
                    </StackPanel>
                </Border>

                <!-- ============ Ingredients ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="INGREDIENTS" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ingredient (choose from the product list)" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="IngredientCombo" IsEditable="True" Padding="8,7" FontSize="14"
                                          SelectionChanged="IngredientCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="QuantityBox" Style="{StaticResource SearchBoxStyle}" Padding="10,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="UnitCombo" IsEditable="True" Padding="8,7" FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="AddIngredientButton" Content="Add Ingredient" Click="AddIngredient_Click"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="CancelEditButton" Content="Cancel edit" Click="CancelEdit_Click"
                                    Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock x:Name="IngredientStatusText" FontSize="12" Foreground="#C62828"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

                        <Separator Margin="0,14,0,10" Background="{StaticResource CardBorderBrush}" />

                        <TextBlock x:Name="IngredientsEmptyText" Text="No ingredients added yet."
                                   Foreground="#9AA8A0" FontSize="13" />
                        <ItemsControl x:Name="IngredientList" ItemTemplate="{StaticResource IngredientRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- ============ Instructions ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="INSTRUCTIONS *" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="One step per line. Steps are numbered automatically." Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="InstructionsBox" Style="{StaticResource SearchBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- ============ Image ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="IMAGE (OPTIONAL)" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Choose image…" Click="ChooseImage_Click" Style="{StaticResource OutlineButton}" />
                            <Button x:Name="ClearImageButton" Content="Clear" Click="ClearImage_Click"
                                    Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ImageNameText" Text="No image - the default placeholder will be used."
                                       Foreground="#6B7A70" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource OutlineButton}" Margin="0,0,10,0" />
            <Button x:Name="SaveButton" Content="Save Recipe" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
