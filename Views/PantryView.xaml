<UserControl x:Class="NutriTrack.UI.Views.PantryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="🏠 Pantry" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="What you have at home. Recipes compare their ingredients against this list."
                       Foreground="#6B7A70" FontSize="13.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Add stock -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" Padding="16,14" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="ProductCombo" Style="{StaticResource FilterComboStyle}" Width="260" MinWidth="260"
                          Margin="0,0,10,0" SelectionChanged="ProductCombo_SelectionChanged" />
                <TextBox x:Name="QuantityBox" Style="{StaticResource SearchBoxStyle}" Width="110" Margin="0,0,10,0"
                         ToolTip="For example 500, 1.5 or 1/2" KeyDown="QuantityBox_KeyDown" />
                <ComboBox x:Name="UnitCombo" Style="{StaticResource FilterComboStyle}" Width="100" MinWidth="100" Margin="0,0,10,0" />
                <Button Content="+ Add to pantry" Click="AddToPantry_Click" Padding="16,9"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" />
            </WrapPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12.5" Margin="4,0,0,10" TextWrapping="Wrap" />

        <!-- Stock list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="PantryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" Padding="16,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2A20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding QuantityLabel}" FontSize="14"
                                               Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveItem_Click" ToolTip="Remove from pantry"
                                            Background="Transparent" BorderThickness="0" Foreground="#9AA8A0" Cursor="Hand" FontSize="14" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Your pantry is empty. Pick a product above and add what you have."
                           Foreground="#6B7A70" FontSize="14" HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
