<UserControl x:Class="NutriTrack.UI.Views.ShoppingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="🛒 Shopping List" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Ingredients you still need. Open a recipe and use “Add missing ingredients to shopping list”."
                       Foreground="#6B7A70" FontSize="13.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" Foreground="#6B7A70" FontSize="12.5" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Foreground="#C62828" FontSize="12.5" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="ClearButton" Content="Clear list" Click="Clear_Click" HorizontalAlignment="Right"
                    Padding="14,7" Background="Transparent" BorderThickness="1" BorderBrush="#A5D6A7"
                    Foreground="#2E7D32" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="ShoppingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" Padding="16,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2A20" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding QuantityLabel}" FontSize="14"
                                               Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" Margin="12,0,16,0" />
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveItem_Click" ToolTip="Remove from list"
                                            Background="Transparent" BorderThickness="0" Foreground="#9AA8A0" Cursor="Hand" FontSize="14" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Your shopping list is empty." Foreground="#6B7A70" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
