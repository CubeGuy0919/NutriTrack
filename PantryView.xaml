<UserControl x:Class="NutriTrack.UI.Views.PantryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:NutriTrack.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ExpiryBackgroundBrushConverter x:Key="ExpiryBackgroundBrushConverter" />
        <conv:ExpiryForegroundBrushConverter x:Key="ExpiryForegroundBrushConverter" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="540" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Pantry Inventory -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🥫 Pantry" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="Your current food inventory and ingredient tracker." Foreground="#6B7A70" FontSize="13.5" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="+ Add item" Style="{StaticResource ActionButtonStyle}"
                        Click="AddItem_Click" VerticalAlignment="Center" Padding="20,11" FontSize="14" />
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Style="{StaticResource SearchBoxStyle}"
                         Tag="Search pantry items..."
                         TextChanged="Filter_Changed" />

                <ComboBox x:Name="CategoryFilterCombo" Grid.Column="2"
                          Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="Filter_Changed" />

                <ComboBox x:Name="ExpiryFilterCombo" Grid.Column="4"
                          Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All items" IsSelected="True" />
                    <ComboBoxItem Content="Expiring soon (≤ 3 days)" />
                    <ComboBoxItem Content="Expired" />
                    <ComboBoxItem Content="Fresh (> 3 days)" />
                    <ComboBoxItem Content="No expiry date" />
                </ComboBox>

                <Button Grid.Column="6" Content="Reset" Click="ResetFilters_Click"
                        Padding="14,8" Background="Transparent" BorderThickness="1"
                        Foreground="#2E7D32" FontWeight="SemiBold" BorderBrush="#A5D6A7" Cursor="Hand" />
            </Grid>

            <!-- Summary bar -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="PantrySummaryText" FontSize="13" Foreground="#6B7A70" VerticalAlignment="Center" />
                <TextBlock x:Name="ExpiringCountBadge" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#B45309" VerticalAlignment="Center" />
            </Grid>

            <!-- Pantry Items Cards / List -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <Grid>
                    <ItemsControl x:Name="PantryItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,14,14" Background="White" CornerRadius="14"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="Black" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Category and Expiry Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA396" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                            <!-- Expiry Badge -->
                                            <Border HorizontalAlignment="Right" CornerRadius="8" Padding="7,3"
                                                    Background="{Binding ExpiryStatus, Converter={StaticResource ExpiryBackgroundBrushConverter}}">
                                                <TextBlock Text="{Binding ExpiryText}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{Binding ExpiryStatus, Converter={StaticResource ExpiryForegroundBrushConverter}}" />
                                            </Border>
                                        </Grid>

                                        <!-- Product Name -->
                                        <TextBlock Grid.Row="1" Text="{Binding ProductName}" FontSize="16" FontWeight="Bold"
                                                   Foreground="#1B2A20" TextWrapping="Wrap" MaxHeight="42" Margin="0,0,0,10" />

                                        <!-- Quantity Row -->
                                        <Border Grid.Row="2" Background="#F8FAF8" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="IN STOCK" FontSize="9.5" FontWeight="Bold" Foreground="#8FA396" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedQuantity}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Action Buttons: Edit / Delete -->
                                        <Grid Grid.Row="3">
                                            <Button Content="Edit" Click="EditItem_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#2E7D32"
                                                    FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Left" Cursor="Hand" />
                                            <Button Content="Remove" Click="DeleteItem_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#DC2626"
                                                    FontSize="12" HorizontalAlignment="Right" Cursor="Hand" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0">
                        <TextBlock Text="🥫" FontSize="44" HorizontalAlignment="Center" />
                        <TextBlock Text="No pantry items found" FontSize="18" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Click '+ Add item' to start tracking your food inventory." FontSize="13.5" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Right Column: Smart Integrations ("Use soon" and "What can I cook?") -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <!-- Section 1: Use Soon (Expiring Items + Recipe Suggestions) -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" Padding="18" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏰" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Use soon" FontSize="17" FontWeight="Bold" Foreground="#1B2A20" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="UseSoonCountBadge" Background="#FEF3C7" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="UseSoonCountText" Text="0 items" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Items expiring soon and suggested recipes to cook them."
                                   FontSize="12" Foreground="#8FA396" Margin="0,0,0,14" />

                        <ItemsControl x:Name="UseSoonItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FDFBF7" BorderBrush="#FCE7C8" BorderThickness="1"
                                            CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Item Header -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Item.ProductName}" FontSize="14" FontWeight="Bold" Foreground="#1B2A20" />
                                                <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,2"
                                                        Background="{Binding Item.ExpiryStatus, Converter={StaticResource ExpiryBackgroundBrushConverter}}">
                                                    <TextBlock Text="{Binding Item.ExpiryText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Item.ExpiryStatus, Converter={StaticResource ExpiryForegroundBrushConverter}}" />
                                                </Border>
                                            </Grid>

                                            <!-- Suggested Recipe text -->
                                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                                <TextBlock Text="Suggested recipe:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA396" />
                                                <TextBlock Text="{Binding RecipeNameDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Button Grid.Row="2" Content="View recipe →" Click="ViewSuggestedRecipe_Click" Tag="{Binding Recipe}"
                                                    Visibility="{Binding HasRecipeVisibility}"
                                                    Background="{StaticResource PrimaryLightBrush}" BorderThickness="0"
                                                    Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                                    FontSize="12" Padding="10,6" Cursor="Hand" HorizontalAlignment="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state for use soon -->
                        <TextBlock x:Name="NoExpiringItemsText" Text="All pantry items are fresh! Nothing expiring soon."
                                   FontSize="12.5" Foreground="#8FA396" FontStyle="Italic" Visibility="Collapsed" Margin="0,4,0,4" />
                    </StackPanel>
                </Border>

                <!-- Section 2: What can I cook? -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🍝" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="What can I cook?" FontSize="17" FontWeight="Bold" Foreground="#1B2A20" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Recipes matching available ingredients in your pantry."
                                   FontSize="12" Foreground="#8FA396" Margin="0,0,0,14" />

                        <ItemsControl x:Name="AvailableRecipesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F4F1" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Recipe.Name}" FontSize="13.5" FontWeight="Bold" Foreground="#1B2A20" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding MatchBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,8,0" />
                                                    <TextBlock Text="·" FontSize="11.5" Foreground="#8FA396" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Recipe.TimeLabel}" FontSize="11.5" Foreground="#8FA396" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="View →" Click="ViewSuggestedRecipe_Click" Tag="{Binding Recipe}"
                                                    Background="{StaticResource PrimaryLightBrush}" BorderThickness="0"
                                                    Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                                    FontSize="11.5" Padding="10,5" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state for available recipes -->
                        <TextBlock x:Name="NoAvailableRecipesText" Text="Add more pantry items to see matching recipes."
                                   FontSize="12.5" Foreground="#8FA396" FontStyle="Italic" Visibility="Collapsed" Margin="0,4,0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Add / Edit Item Modal Dialog Overlay -->
        <Grid x:Name="ItemModal" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#66000000">
            <Border Width="480" Background="White" CornerRadius="16" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="ModalTitleText" Text="Add Pantry Item" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                        <Button Content="✕" Click="CancelItemDialog_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#8FA396" Cursor="Hand" />
                    </Grid>

                    <!-- Product selector / name -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Product *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                        <ComboBox x:Name="DialogProductCombo" IsEditable="True"
                                  Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="DialogProductCombo_SelectionChanged" />
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                        <TextBox x:Name="DialogCategoryInput" Style="{StaticResource SearchBoxStyle}" />
                    </StackPanel>

                    <!-- Quantity and Unit -->
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantity *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <TextBox x:Name="DialogQuantityInput" Text="1" Style="{StaticResource SearchBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit (e.g. g, ml, pcs, L)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <TextBox x:Name="DialogUnitInput" Text="pcs" Style="{StaticResource SearchBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Expiry Date -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="Expiry Date" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                        <DatePicker x:Name="DialogExpiryPicker" Height="40" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelItemDialog_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="18,9" />
                        <Button Content="Save Item" Click="SaveItemDialog_Click" Style="{StaticResource ActionButtonStyle}" Padding="22,9" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
