<Window x:Class="NutriTrack.UI.Views.RecipeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe Details" Height="1000" Width="1000"
        MinHeight="550" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header / Image -->
            <RowDefinition Height="Auto" />
            <!-- Key Info Badges -->
            <RowDefinition Height="*" />
            <!-- Ingredients & Instructions -->
            <RowDefinition Height="Auto" />
            <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- Image & Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <!-- Circular Food Image Container -->
            <Border Width="120" Height="120" 
                CornerRadius="60" 
                ClipToBounds="True" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,12" 
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="2">    
                    <Grid>
                        <!-- Underlay Image -->
                    <Image x:Name="RecipeImage1" Stretch="UniformToFill" Source="default_food.png"/>

                        <!-- Overlay Image for Smooth Fade Cross-Transition -->
                        <Image x:Name="RecipeImage2" Stretch="UniformToFill" Opacity="0" />
                    </Grid>
            </Border>
            <TextBlock x:Name="RecipeNameText" Text="Recipe Name" FontSize="22" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="CuisineCategoryText" Text="Cuisine • Category" FontSize="13" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Background="White" CornerRadius="8" Padding="10" Margin="4" BorderBrush="#E3E8E4" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PREP TIME" FontSize="10" Foreground="#6B7A70" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PrepTimeText" Text="0 min" FontSize="16" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="10" Margin="4" BorderBrush="#E3E8E4" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="COOK TIME" FontSize="10" Foreground="#6B7A70" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CookTimeText" Text="0 min" FontSize="16" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="10" Margin="4" BorderBrush="#E3E8E4" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CALORIES" FontSize="10" Foreground="#6B7A70" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CaloriesText" Text="0 kcal" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0">
                
                <TextBlock Text="SENSITIVITIES &amp; ALLERGENS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E3E8E4" BorderThickness="1" Margin="0,0,0,16">
                    <TextBlock x:Name="SensitivitiesText" Text="None" FontSize="13" Foreground="#2C3E35" TextWrapping="Wrap" />
                </Border>

                <!-- SCALING & UNIT CONVERSION CONTROLS -->
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E3E8E4" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Serving Size Slider -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="SERVINGS: " FontSize="11" FontWeight="Bold" Foreground="#6B7A70" />
                                <TextBlock x:Name="ServingsValueText" Text="1" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" />
                            </StackPanel>
                            <Slider x:Name="ServingsSlider" 
                                Minimum="1" 
                                Maximum="12" 
                                Value="1" 
                                TickFrequency="1" 
                                IsSnapToTickEnabled="True" 
                                ValueChanged="ServingsSlider_ValueChanged" />
                        </StackPanel>

                        <!-- Unit System Radio Buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="UNITS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MetricRadio" Content="Metric" IsChecked="True" GroupName="UnitSystem" Checked="UnitSystem_Changed" Margin="0,0,8,0"/>
                                <RadioButton x:Name="ImperialRadio" Content="Imperial" GroupName="UnitSystem" Checked="UnitSystem_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <TextBlock Text="INGREDIENTS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E3E8E4" BorderThickness="1" Margin="0,0,0,16">
                    <TextBlock x:Name="IngredientsText" Text="Ingredients list..." FontSize="13" Foreground="#2C3E35" TextWrapping="Wrap" LineHeight="20" />
                </Border>

                <TextBlock Text="INSTRUCTIONS" FontSize="11" FontWeight="Bold" Foreground="#6B7A70" Margin="0,0,0,4" />
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E3E8E4" BorderThickness="1">
                    <TextBlock x:Name="InstructionsText" Text="Preparation steps..." FontSize="13" Foreground="#2C3E35" TextWrapping="Wrap" LineHeight="20" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Button Grid.Row="3" Content="Close" Height="36" Width="100" HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold" BorderBrush="#A5D6A7"
                Click="CloseButton_Click" />
    </Grid>
</Window>