<UserControl x:Class="NutriTrack.UI.Views.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Main Receipts Area -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🧾 Receipts" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="Add and browse your grocery receipts, track spending and view purchased items."
                               Foreground="#6B7A70" FontSize="13.5" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="+ Add Receipt" Style="{StaticResource ActionButtonStyle}"
                        Click="AddReceipt_Click" VerticalAlignment="Center" Padding="20,11" FontSize="14" />
            </Grid>

            <!-- Filter Row -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Style="{StaticResource SearchBoxStyle}"
                         Tag="Search store or item..."
                         TextChanged="Filter_Changed" />

                <ComboBox x:Name="StoreFilterCombo" Grid.Column="2"
                          Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="Filter_Changed" />

                <ComboBox x:Name="DateFilterCombo" Grid.Column="4"
                          Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All time" IsSelected="True" />
                    <ComboBoxItem Content="This month" />
                    <ComboBoxItem Content="Last month" />
                    <ComboBoxItem Content="Last 30 days" />
                </ComboBox>

                <Button Grid.Column="6" Content="Reset" Click="ResetFilters_Click"
                        Padding="14,8" Background="Transparent" BorderThickness="1"
                        Foreground="#2E7D32" FontWeight="SemiBold" BorderBrush="#A5D6A7" Cursor="Hand" />
            </Grid>

            <!-- Total count and spending bar -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="ResultSummaryText" FontSize="13" Foreground="#6B7A70" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalSpendingText" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" />
            </Grid>

            <!-- Receipts Cards ScrollViewer -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <Grid>
                    <ItemsControl x:Name="ReceiptsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="ReceiptCard_Click" Tag="{Binding}" Cursor="Hand"
                                        Width="290" Margin="0,0,16,16" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" CornerRadius="14" Background="White"
                                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Store Header -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                                                <TextBlock Text="🏬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Store}" FontSize="16" FontWeight="Bold" Foreground="#1B2A20" />
                                                                <TextBlock Text="{Binding PurchaseDate, StringFormat='{}{0:MMMM d, yyyy}'}" FontSize="12" Foreground="#8FA396" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Divider -->
                                                    <Border Grid.Row="1" Height="1" Background="#F0F4F1" Margin="0,0,0,12" />

                                                    <!-- Items count & Amount -->
                                                    <Grid Grid.Row="2" Margin="0,0,0,14">
                                                        <StackPanel HorizontalAlignment="Left">
                                                            <TextBlock Text="ITEMS" FontSize="10" FontWeight="Bold" Foreground="#8FA396" />
                                                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E35" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Right">
                                                            <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#8FA396" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} Ft'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- View Details Button -->
                                                    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="0,7">
                                                        <TextBlock Text="View details →" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0">
                        <TextBlock Text="🧾" FontSize="44" HorizontalAlignment="Center" />
                        <TextBlock Text="No receipts found" FontSize="18" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Click '+ Add Receipt' to record your first grocery receipt." FontSize="13.5" Foreground="#6B7A70" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Right Side Detail / Drawer Panel -->
        <Border x:Name="DetailBorder" Grid.Column="1" Visibility="Collapsed"
                Background="White" CornerRadius="16" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" Margin="20,0,0,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="DetailStoreText" Text="TESCO" FontSize="22" FontWeight="Bold" Foreground="#1B2A20" />
                        <TextBlock x:Name="DetailDateText" Text="October 4, 2026" FontSize="13" Foreground="#8FA396" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="✕" Click="CloseDetail_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#8FA396" Cursor="Hand" Padding="6,2" />
                </Grid>

                <!-- Total Amount Banner -->
                <Border Grid.Row="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Total Paid" FontSize="11" FontWeight="Bold" Foreground="#5A7361" />
                            <TextBlock x:Name="DetailTotalText" Text="18,450 Ft" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DetailItemCountText" Text="12 items" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Items List -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PURCHASED ITEMS" FontSize="11" FontWeight="Bold" Foreground="#8FA396" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F4F1" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1B2A20" />
                                                <TextBlock FontSize="11.5" Foreground="#8FA396" Margin="0,2,0,0">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}" />
                                                    <Run Text="×" />
                                                    <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat='{}{0:N0} Ft'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:N0} Ft'}"
                                                       FontSize="13.5" FontWeight="Bold" Foreground="#2C3E35" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Actions Footer -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="✏ Edit" Click="EditSelectedReceipt_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="🗑 Delete" Click="DeleteSelectedReceipt_Click" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add/Edit Receipt Modal Dialog Overlay -->
        <Grid x:Name="AddReceiptModal" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#66000000">
            <Border Width="620" MaxHeight="680" Background="White" CornerRadius="16" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="ModalTitleText" Text="Add New Receipt" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                        <Button Content="✕" Click="CancelReceiptDialog_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#8FA396" Cursor="Hand" />
                    </Grid>

                    <!-- Store and Date Form Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Store name *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <TextBox x:Name="DialogStoreInput" Style="{StaticResource SearchBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Purchase date *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <DatePicker x:Name="DialogDatePicker" Height="40" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Items Table -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" MaxHeight="220" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Items" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,6" />

                        <!-- Add Item Row -->
                        <Border Grid.Row="1" Background="#F9FAF9" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="DialogProductCombo" Grid.Column="0" IsEditable="True"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectionChanged="DialogProductCombo_SelectionChanged" />

                                <TextBox x:Name="DialogQuantityInput" Grid.Column="2" Text="1"
                                         Style="{StaticResource SearchBoxStyle}" HorizontalContentAlignment="Center" />

                                <TextBox x:Name="DialogUnitPriceInput" Grid.Column="4"
                                         Style="{StaticResource SearchBoxStyle}" HorizontalContentAlignment="Right" />

                                <Button Grid.Column="6" Content="+ Add" Click="DialogAddItem_Click"
                                        Style="{StaticResource ActionButtonStyle}" Padding="12,7" />
                            </Grid>
                        </Border>

                        <!-- Items DataGrid/List -->
                        <DataGrid x:Name="DialogItemsGrid" Grid.Row="2"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#E5E7EB" Background="White"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} Ft'}" Width="90" />
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat='{}{0:N0} Ft'}" Width="90" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Click="DialogRemoveItem_Click"
                                                    Tag="{Binding}" Background="Transparent" BorderThickness="0"
                                                    Foreground="#DC2626" FontSize="11" Cursor="Hand" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Calculated Total Banner -->
                    <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="Calculated Total:" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" VerticalAlignment="Center" />
                            <TextBlock x:Name="DialogTotalText" Text="0 Ft" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelReceiptDialog_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="18,9" />
                        <Button Content="Save Receipt" Click="SaveReceiptDialog_Click" Style="{StaticResource ActionButtonStyle}" Padding="22,9" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
