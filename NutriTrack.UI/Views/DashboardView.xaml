<UserControl x:Class="NutriTrack.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:NutriTrack.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ExpiryBackgroundBrushConverter x:Key="ExpiryBackgroundBrushConverter" />
        <conv:ExpiryForegroundBrushConverter x:Key="ExpiryForegroundBrushConverter" />

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7A70" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">
            <!-- Header -->
            <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,4" />
            <TextBlock Text="A quick look at where things stand."
                       Foreground="#6B7A70" FontSize="13.5" Margin="0,0,0,22" />

            <!-- 3 Metrics Tiles -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Receipts This Month -->
                <Border Grid.Column="0" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="RECEIPTS THIS MONTH" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock x:Name="ReceiptsCountText" Text="0" Style="{StaticResource TileValueStyle}" />
                        <TextBlock x:Name="ReceiptsSpendingText" Text="0 Ft total spent" FontSize="12" Foreground="#8FA396" />
                    </StackPanel>
                </Border>

                <!-- Total Recipes -->
                <Border Grid.Column="2" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL RECIPES" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock x:Name="RecipesCountText" Text="0" Style="{StaticResource TileValueStyle}" />
                        <TextBlock x:Name="RecipesCuisinesText" Text="Categorized &amp; searchable" FontSize="12" Foreground="#8FA396" />
                    </StackPanel>
                </Border>

                <!-- Avg. Calories / Day -->
                <Border Grid.Column="4" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="AVG. CALORIES / SERVING" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock x:Name="AvgCaloriesText" Text="—" Style="{StaticResource TileValueStyle}" />
                        <TextBlock x:Name="AvgCaloriesSubtext" Text="Across recipe database" FontSize="12" Foreground="#8FA396" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Section: Recipe of the day + Use soon -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="360" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Left: Recipe of the day Card -->
                <Border Grid.Column="0" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Badge & Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌟" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Recipe of the day" FontSize="18" FontWeight="Bold" Foreground="#1B2A20" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="RecipePantryMatchBadge" Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                                <TextBlock x:Name="RecipePantryMatchText" Text="Pantry matched" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- Recipe Name -->
                        <TextBlock x:Name="RecipeNameText" Grid.Row="1" Text="Chicken Marsala"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />

                        <!-- Cuisine & Category -->
                        <TextBlock x:Name="RecipeCategoryText" Grid.Row="2" Text="Italian · Meal"
                                   FontSize="13.5" Foreground="#6B7A70" Margin="0,0,0,18" />

                        <!-- Meta Info Row (Time, Calories, Ingredients) -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,20">
                            <Border Background="#F9FAF9" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⏱ TIME" FontSize="10" FontWeight="Bold" Foreground="#8FA396" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RecipeTimeText" Text="40 min" FontSize="14" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F9FAF9" CornerRadius="10" Padding="10" Margin="3,0,3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔥 CALORIES" FontSize="10" FontWeight="Bold" Foreground="#8FA396" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RecipeCaloriesText" Text="520 kcal" FontSize="14" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F9FAF9" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🥣 ITEMS" FontSize="10" FontWeight="Bold" Foreground="#8FA396" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RecipeIngredientsCountText" Text="8 items" FontSize="14" FontWeight="Bold" Foreground="#2C3E35" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Action Button -->
                        <Button Grid.Row="4" Content="View Recipe Details →" Click="OpenRecipeOfTheDay_Click"
                                Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Padding="20,10" />
                    </Grid>
                </Border>

                <!-- Right: Use soon Section -->
                <Border Grid.Column="2" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏰" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Use soon" FontSize="18" FontWeight="Bold" Foreground="#1B2A20" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="UseSoonCountBadge" Background="#FEF3C7" CornerRadius="8" Padding="7,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="UseSoonCountText" Text="0 items" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </Grid>

                        <!-- Use Soon Items List -->
                        <StackPanel Grid.Row="1">
                            <ItemsControl x:Name="DashboardUseSoonList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FDFBF7" BorderBrush="#FCE7C8" BorderThickness="1"
                                                CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Item.ProductName}" FontSize="13.5" FontWeight="Bold" Foreground="#1B2A20" />
                                                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,2"
                                                            Background="{Binding Item.ExpiryStatus, Converter={StaticResource ExpiryBackgroundBrushConverter}}">
                                                        <TextBlock Text="{Binding Item.ExpiryText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding Item.ExpiryStatus, Converter={StaticResource ExpiryForegroundBrushConverter}}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="1" FontSize="12" Foreground="#8FA396" Margin="0,4,0,6">
                                                    <Run Text="Suggested: " />
                                                    <Run Text="{Binding RecipeNameDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                                </TextBlock>

                                                <Button Grid.Row="2" Content="View recipe →" Click="ViewSuggestedRecipe_Click" Tag="{Binding Recipe}"
                                                        Visibility="{Binding HasRecipeVisibility}"
                                                        Background="{StaticResource PrimaryLightBrush}" BorderThickness="0"
                                                        Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                                        FontSize="11" Padding="8,4" Cursor="Hand" HorizontalAlignment="Right">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoExpiringItemsText" Text="All items in your pantry are fresh!"
                                       FontSize="13" Foreground="#8FA396" FontStyle="Italic" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>