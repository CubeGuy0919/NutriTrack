<Window x:Class="NutriTrack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="320"/>
            <ColumnDefinition Width="8*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,32">
                    <TextBlock Text="🥗" FontSize="50" HorizontalAlignment="Center" Foreground="LightBlue"/>
                    <TextBlock Text="NutriTrack" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="LightBlue"/>
                </StackPanel>

                
                <StackPanel DockPanel.Dock="Top" Margin="12,0" HorizontalAlignment="Center">
                    <Button Content="🏠  Home" ToolTip="Your overview and quick links"      Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click" />
                    <Button Content="📖  Recipes" ToolTip="Find recipes and mark meals you have made"   Style="{StaticResource NavButtonStyle}" Click="NavRecipes_Click" />
                    <Button Content="🧾  Receipts" ToolTip="Save grocery receipts and expiry dates"  Style="{StaticResource NavButtonStyle}" Click="NavReceipts_Click" />
                    <Button Content="🥫  My Pantry" ToolTip="See the food you have at home"    Style="{StaticResource NavButtonStyle}" Click="NavPantry_Click" />
                    <Button Content="🛒  Shopping List" ToolTip="Keep track of things to buy"  Style="{StaticResource NavButtonStyle}" Click="NavShopping_Click" />
                    <Button Content="📊  Statistics" ToolTip="See your spending and meals made" Style="{StaticResource NavButtonStyle}" Click="NavAnalytics_Click" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="v1.0"
                           Foreground="#8FA396" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
            </DockPanel>
        </Border>

        
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="24" />

    </Grid>
</Window>
